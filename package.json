{
  "name": "baihepailei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "dev:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/dev.ps1",
    "import:clean-seed": "node scripts/import/direct-seed-clean-data.mjs",
    "import:demo": "node scripts/import/demo-fixtures.mjs",
    "export:lite-search": "node scripts/export/build-lite-search-index.mjs",
    "export:lite-details": "node scripts/export/build-lite-detail-index.mjs && node scripts/export/enrich-lite-detail-index.mjs",
    "export:lite-details:base": "node scripts/export/build-lite-detail-index.mjs",
    "export:lite-details:enrich": "node scripts/export/enrich-lite-detail-index.mjs",
    "test:search": "node --test tests/search-utils.test.mjs",
    "test:frontend-polish": "node --test tests/frontend-polish.test.mjs",
    "test:works-rank": "node --test tests/works-rank-page.test.mjs",
    "test:frontend": "pnpm test:frontend-polish && pnpm test:works-rank && pnpm test:search"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "latest",
    "@payloadcms/next": "latest",
    "@payloadcms/richtext-lexical": "latest",
    "graphql": "latest",
    "next": "^16.2.6",
    "payload": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest"
  }
}
