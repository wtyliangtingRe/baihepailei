{
  "name": "baihepailei",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:webpack": "next dev --webpack",
    "preview": "pnpm validate:release && pnpm audit:merge && next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/start-production.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "audit:merge": "node scripts/audit-public-catalog-merge.mjs",
    "validate:release": "node scripts/validate-public-release.mjs",
    "validate:ui": "node scripts/validate-public-ui.mjs",
    "smoke:public": "node scripts/smoke-public-site.mjs",
    "check": "pnpm validate:release && pnpm audit:merge && pnpm validate:ui && pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "next": "^16.2.6",
    "pg": "latest",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "5.9.3"
  }
}
