# Local development only. Copy this file to .env and change values before production.
DATABASE_URL=postgres://baihe:CHANGE_ME_DEV_PASSWORD@localhost:15432/baihepailei
PAYLOAD_SECRET=CHANGE_ME_LOCAL_PAYLOAD_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Explicit per-deployment owner. Official Baihepailei should set this to its designated owner email.
# Do not inherit another deployment's owner identity when self-hosting.
SITE_OWNER_EMAIL=owner@example.com

# Required for real verification and password-reset delivery.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM_ADDRESS=no-reply@example.com
SMTP_FROM_NAME=Baihepailei
