# The bundled, versioned release is the default runtime source.
# Override only when validating another compatible release directory.
# BAIHEPAILEI_RELEASE_DIR=/absolute/path/to/data/public-release/v1
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Explicit owner identity for this deployment.
SITE_OWNER_EMAIL=owner@example.com

# Optional local Bangumi proxy for future discovery tooling. It is not a runtime identity fallback.
# BANGUMI_PROXY=http://127.0.0.1:10808

# The complete public edition is the default; set "text" only for a low-bandwidth mirror.
NEXT_PUBLIC_MEDIA_MODE=enhanced

# Independent discovery-hint channels. Blank channels are hidden.
# Hints never write formal WorkLineage, Research, Assessment, or Rating objects directly.
NEXT_PUBLIC_FEEDBACK_EMAIL=
NEXT_PUBLIC_FEEDBACK_FORM_URL=
NEXT_PUBLIC_FEEDBACK_ISSUE_URL=
