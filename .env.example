# Local development only. Copy this file to .env and change values before production.
DATABASE_URL=postgres://baihe:CHANGE_ME_DEV_PASSWORD@localhost:15432/baihepailei
PAYLOAD_SECRET=CHANGE_ME_LOCAL_PAYLOAD_SECRET
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Explicit owner identity for this deployment.
SITE_OWNER_EMAIL=owner@example.com

# Local controlled refresh reads SITE_OWNER_EMAIL, but the password should be entered
# interactively into RADAR_PAYLOAD_PASSWORD for the current PowerShell process.
# Do not store a real administrator password in this file.

# Optional local Bangumi proxy. Example for a v2rayN mixed listener:
# BANGUMI_PROXY=http://127.0.0.1:10808

# Public deployment profile. The complete edition is the default; set "text" only for a low-bandwidth mirror.
NEXT_PUBLIC_MEDIA_MODE=enhanced

# Optional feedback fallbacks. Leave a channel blank to hide it from the public feedback page.
NEXT_PUBLIC_FEEDBACK_EMAIL=feedback@example.com
NEXT_PUBLIC_FEEDBACK_FORM_URL=
NEXT_PUBLIC_FEEDBACK_ISSUE_URL=

# Local testing can disable verification. Production should set this to true and configure real SMTP.
ACCOUNT_EMAIL_VERIFICATION_ENABLED=false

# Required for production verification and password-reset delivery. Blank values disable SMTP locally.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Baihepailei

# Existing deployments keep stewardship notices enabled; set false only for an isolated migration review.
STEWARDSHIP_NOTICES_SCHEMA_READY=true

# Never enable against a valuable database without a reviewed migration and backup.
PAYLOAD_DB_PUSH=false

# Existing deployments keep Radar public records enabled after the additive migration.
# Set false only in the isolated migration snapshot preparer.
RADAR_PUBLIC_RECORDS_SCHEMA_READY=true

# Existing deployments keep Radar public ratings enabled after the additive migration.
# Set false only while generating an isolated pre-ratings schema snapshot.
RADAR_PUBLIC_RATINGS_SCHEMA_READY=true