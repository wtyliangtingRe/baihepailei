# The bundled, versioned release is the default runtime source.
# Override only when validating another compatible release directory.
# BAIHEPAILEI_RELEASE_DIR=/absolute/path/to/data/public-release/v1
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Host-side loopback port used by Docker Compose. Keep the application behind
# the server's existing TLS reverse proxy instead of exposing this port publicly.
BAIHEPAILEI_PORT=3000

# Explicit owner identity for this deployment.
SITE_OWNER_EMAIL=owner@example.com

# Optional local Bangumi proxy for future discovery tooling. It is not a runtime identity fallback.
# BANGUMI_PROXY=http://127.0.0.1:10808

# The complete public edition is the default; set "text" only for a low-bandwidth mirror.
NEXT_PUBLIC_MEDIA_MODE=enhanced

# Independent discovery-hint channels. Blank email/form channels are hidden.
# The accepted future anonymous channel is a separate Cloudflare-hosted,
# text-only, no-attachment service. Never point this at an AWS same-origin write
# endpoint or any service that can write the core database. Hints remain pending
# until manual review and never write formal data directly.
NEXT_PUBLIC_FEEDBACK_EMAIL=
NEXT_PUBLIC_FEEDBACK_FORM_URL=
# Deploy deploy/cloudflare-feedback independently, verify it, then set its HTTPS
# origin above. The site pre-fills Work ID/title; it never proxies submissions.

# The application defaults to this authenticated GitHub Issue Form so the page
# always has a real submission link. This repository is currently private, so a
# public deployment should override it with a dedicated public issues-only repo
# containing only public templates, guidance, and untrusted pending Issues.
NEXT_PUBLIC_FEEDBACK_ISSUE_URL=https://github.com/wtyliangtingRe/baihepailei/issues/new
# A ready-to-publish public-only repository skeleton is in deploy/github-feedback.
# Optional images are hosted by GitHub; never auto-download or mirror them to AWS.
